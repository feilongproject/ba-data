    },
    {
      "GroupId": 8431999017,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "HideUI": false,
      "LocalizeKR": "(수집한 데이터를 저장했어.)",
      "LocalizeJP": "（収集データ、保存したぞ）"
    },
    {
      "GroupId": 8431999018,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "HideUI": false,
      "LocalizeKR": "(네루도 데이터를 가져와야 해요.)",
      "LocalizeJP": "（ネルにもデータを持ってきてもらわねば）"
    },
    {
      "GroupId": 8431999019,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "HideUI": false,
      "LocalizeKR": "(세이아도 데이터를 가져와야 해.)",
      "LocalizeJP": "（セイアのデータも必要だな）"
    },
